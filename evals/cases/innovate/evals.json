        "allow": [
          ".ai/worklog/20260910_resumable-coordination/research_resumable-coordination.md"
        ],
        "deny": [
          ".ai/worklog/**/*spec_*.md",
          "src/**",
          "docs/**",
          "skills/**",
          "evals/**"
        ]
      },
      "forbidden_effects": [
